# ==============================================================================
# JOSHPER SOLUTIONS - ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env)
# ==============================================================================
# Copia este archivo como `.env` o `.env.production` y ajusta los valores.

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (PostgreSQL)
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=joshperdb
DB_PORT=5432
DB_HOST=database
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_POOL_MAX=20

# ------------------------------------------------------------------------------
# 2. SUPABASE BACKEND (Opcional / Integración Nube)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y AUTENTICACIÓN
# ------------------------------------------------------------------------------
# Genera una clave segura de al menos 32 caracteres (ej: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ------------------------------------------------------------------------------
# 4. SERVIDOR Y URLS DE LA APLICACIÓN
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
APP_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 5. CARGA DE ARCHIVOS (UPLOADS)
# ------------------------------------------------------------------------------
UPLOAD_MAX_SIZE=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ------------------------------------------------------------------------------
# 6. EMAILS TRANSACCIONALES (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Joshper Solutions <notificaciones@joshper.com>"

# ------------------------------------------------------------------------------
# 7. ALMACENAMIENTO EN LA NUBE (Opcional - Cloudinary)
# ------------------------------------------------------------------------------
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 8. LOGS Y MONITORIZACIÓN (Opcional)
# ------------------------------------------------------------------------------
LOG_LEVEL=info
